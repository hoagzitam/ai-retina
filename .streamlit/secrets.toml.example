# Configure these in the hosting secret manager. Never commit actual values.
APP_ENV = "production"
# Copy Supabase Connect -> Transaction pooler URI (port 6543), percent-encode
# reserved password characters, and require TLS. Use a dedicated app DB role.
DATABASE_URL = "postgresql://app_role.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require"
ADMIN_PASSWORD = "REPLACE_WITH_UNIQUE_RANDOM_ADMIN_SECRET"
APP_ACCESS_PASSWORD = "REPLACE_WITH_DIFFERENT_RANDOM_ACCESS_SECRET"
SUPABASE_URL = "https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_KEY = "REPLACE_WITH_SERVER_SIDE_STORAGE_SECRET"
SUPABASE_STORAGE_BUCKET = "oct-cases"
CASE_MANIFEST_PATH = "approved/cases.json"
# The app must ALSO be restricted to its owner in the hosting access policy.
# Never place a real manifest or patient image in this public repository.
