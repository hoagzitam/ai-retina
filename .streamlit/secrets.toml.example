# Copy this file to .streamlit/secrets.toml for local development
# (that path is gitignored) or paste the same keys into
# Streamlit Community Cloud -> App settings -> Secrets.

# Leave DATABASE_URL unset to use a local SQLite file (airetina_local.db).
# DATABASE_URL = "postgresql://user:password@host:5432/dbname"

ADMIN_PASSWORD = "changeme"
APP_ENV = "development"

# Optional: only needed if you wire up real, private OCT/fundus images
# via Supabase Storage instead of the built-in synthetic demo images.
# SUPABASE_URL = "https://xxxx.supabase.co"
# SUPABASE_SERVICE_KEY = "sb_secret_..."
# SUPABASE_STORAGE_BUCKET = "oct-cases"
# SIGNED_URL_TTL = 300
